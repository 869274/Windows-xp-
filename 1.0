<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RetroCore Windows 5.0 – Ultimate Edition</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; font-family: Tahoma, 'Segoe UI', sans-serif; font-size: 11px; user-select: none; background: #5d9ce6; }
    body { background: url('https://www.windowslatest.com/wp-content/uploads/2024/10/Windows-XP-Bliss-Wallpaper-4K-scaled.jpg') center / cover no-repeat; }
    :root { --blue: #245edb; --header: linear-gradient(to bottom, #245edb 0%, #3f8cf3 9%, #245edb 18%, #1b4ca3 100%); --taskbar: linear-gradient(to bottom, #245edb 0%, #3f8cf3 9%, #245edb 18%, #1b4ca3 92%, #163b7e 100%); }
    #boot-screen { position: fixed; inset: 0; background: #000; z-index: 999999; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 30px; }
    #boot-screen small { display: block; font-size: 13px; text-align: center; margin-top: 16px; }
    #desktop { height: calc(100vh - 30px); padding: 15px; display: flex; flex-direction: column; flex-wrap: wrap; align-content: flex-start; gap: 18px; }
    .desktop-icon { width: 90px; padding: 5px; text-align: center; color: white; cursor: pointer; display: flex; flex-direction: column; align-items: center; text-shadow: 2px 2px 3px #000; }
    .desktop-icon:hover { background: rgba(255,255,255,.12); }
    .desktop-icon .icon { font-size: 42px; line-height: 1.1; margin-bottom: 5px; }
    .window { width: 440px; height: 300px; position: absolute; display: none; z-index: 100; background: #f1f0e8; border: 3px solid var(--blue); border-radius: 7px 7px 0 0; box-shadow: 4px 6px 22px #0006; }
    .window-header { height: 26px; padding: 4px 7px; color: white; font-weight: bold; background: var(--header); display: flex; align-items: center; justify-content: space-between; cursor: grab; touch-action: none; }
    .window-title { display: flex; align-items: center; gap: 6px; }
    .window-controls { display: flex; gap: 3px; }
    .window-controls button { width: 22px; height: 18px; padding: 0; color: #fff; font-weight: bold; cursor: pointer; border: 1px solid #3338; border-radius: 2px; background: linear-gradient(#3c7be6,#1640a3); }
    .window-controls .close { background: linear-gradient(#e76446,#b83314); }
    .window-body { height: calc(100% - 26px); padding: 10px; background: #fff; overflow: auto; }
    #win-notepad { left: 300px; top: 80px; }
    #win-cmd { left: 80px; top: 150px; background: #000; }
    #win-recycle { left: 210px; top: 190px; width: 360px; height: 220px; }
    .notepad-toolbar { display: flex; gap: 5px; padding: 2px; margin-bottom: 4px; background: #eee; }
    .notepad-toolbar button, .nav-btn { cursor: pointer; }
    #note-text { width: 100%; height: calc(100% - 30px); resize: none; font: 12px Courier, monospace; padding: 5px; user-select: text; }
    .cmd-box { height: 100%; padding: 5px; background: #000; color: #fff; font: 11px monospace; overflow: auto; user-select: text; }
    #cmd-history { white-space: pre-wrap; margin-bottom: 5px; line-height: 1.3; }
    .cmd-input-line { display: flex; }
    .cmd-prompt { color: #0f0; font-weight: bold; margin-right: 5px; }
    #cmd-input-field { flex-grow: 1; background: transparent; border: 0; outline: 0; color: white; font: inherit; }
    #taskbar { position: fixed; bottom: 0; left: 0; width: 100%; height: 30px; display: flex; align-items: center; z-index: 99999; background: var(--taskbar); box-shadow: inset 0 1px 1px #ffffff66; }
    #start-button { height: 100%; width: 100px; border: 0; border-radius: 0 7px 7px 0; color: white; font-weight: bold; font-style: italic; font-size: 17px; background: linear-gradient(#60af47,#398a23); cursor: pointer; }
    #open-apps-container { display: flex; gap: 4px; margin-left: 10px; }
    .taskbar-app-btn { height: 24px; padding: 2px 8px; color: white; background: linear-gradient(#3c7be6,#1f4994); border: 1px solid #112a59; border-radius: 3px; cursor: pointer; }
    #taskbar-right { margin-left: auto; height: 100%; padding: 0 12px; display: flex; align-items: center; color: white; background: linear-gradient(#0f69e4,#0046b7); }
    #start-menu { position: fixed; display: none; bottom: 30px; left: 0; width: 240px; padding: 6px 0; background: white; border: 2px solid var(--blue); border-radius: 0 5px 0 0; box-shadow: 3px -3px 20px #0006; z-index: 100000; }
    .start-menu-item { padding: 9px 15px; cursor: pointer; color: #333; }
    .start-menu-item:hover { background: #316ac5; color: white; }
    @media (max-width: 600px) { .window { width: min(90vw, 440px); } #win-notepad, #win-cmd, #win-recycle { left: 5vw; top: 8vh; } }
  </style>
</head>
<body>
  <div id="boot-screen"><div>Windows XP<small>Starting RetroCore...</small></div></div>
  <main id="desktop">
    <div class="desktop-icon" onclick="openWindow('win-notepad')"><span class="icon">📝</span><span>Notepad</span></div>
    <div class="desktop-icon" onclick="openWindow('win-cmd')"><span class="icon">💻</span><span>CMD</span></div>
    <div class="desktop-icon" onclick="openWindow('win-recycle')"><span class="icon">🗑️</span><span>Recycle Bin</span></div>
  </main>

  <section class="window" id="win-notepad" aria-label="Notepad">
    <div class="window-header"><div class="window-title"><span>📝</span> Retro Notepad</div><div class="window-controls"><button class="min" onclick="minimizeWindow('win-notepad')" aria-label="Minimize">_</button><button class="close" onclick="closeWindow('win-notepad')" aria-label="Close">X</button></div></div>
    <div class="window-body" style="padding:4px"><div class="notepad-toolbar"><button onclick="saveNote()">Save</button><button onclick="document.getElementById('note-text').value=''">Clear</button></div><textarea id="note-text" placeholder="Write your notes here..."></textarea></div>
  </section>

  <section class="window" id="win-cmd" aria-label="CMD">
    <div class="window-header"><div class="window-title"><span>💻</span> CMD RetroCore Terminal</div><div class="window-controls"><button class="min" onclick="minimizeWindow('win-cmd')" aria-label="Minimize">_</button><button class="close" onclick="closeWindow('win-cmd')" aria-label="Close">X</button></div></div>
    <div class="window-body" style="padding:0;background:#000"><div class="cmd-box" onclick="document.getElementById('cmd-input-field').focus()"><div id="cmd-history">RetroCore Windows 5.0 [Ultimate Version 2026]\nType 'help' to view commands.</div><div class="cmd-input-line"><span class="cmd-prompt">C:\\Angelo_OS&gt;</span><input id="cmd-input-field" onkeydown="handleCmd(event)" autocomplete="off" /></div></div></div>
  </section>

  <section class="window" id="win-recycle" aria-label="Recycle Bin">
    <div class="window-header"><div class="window-title"><span>🗑️</span> Recycle Bin</div><div class="window-controls"><button class="min" onclick="minimizeWindow('win-recycle')" aria-label="Minimize">_</button><button class="close" onclick="closeWindow('win-recycle')" aria-label="Close">X</button></div></div>
    <div class="window-body" style="text-align:center"><h3>Recycle Bin</h3><p>Nothing is deleted from this simulation.</p><button class="nav-btn" onclick="alert('Recycle bin has been emptied.')">Empty Recycle Bin</button><div style="margin-top:18px;font-size:30px">🗑️</div></div>
  </section>

  <div id="start-menu">
    <div class="start-menu-item" onclick="launchFromStart('win-notepad')">📝 Notepad</div>
    <div class="start-menu-item" onclick="launchFromStart('win-cmd')">💻 CMD</div>
    <div class="start-menu-item" onclick="launchFromStart('win-recycle')">🗑️ Recycle Bin</div>
  </div>
  <footer id="taskbar"><button id="start-button" onclick="toggleStartMenu()">🪟 start</button><div id="open-apps-container"></div><div id="taskbar-right"><span id="digital-clock"></span></div></footer>

  <script>
    setTimeout(() => { document.getElementById('boot-screen').style.display = 'none'; }, 1200);
    let topZ = 100;
    const openApps = new Set();
    function openWindow(id) {
      const win = document.getElementById(id);
      if (!win) return;
      win.style.display = 'block';
      win.style.zIndex = ++topZ;
      openApps.add(id);
      renderTaskbarApps();
    }
    function closeWindow(id) {
      const win = document.getElementById(id);
      if (win) win.style.display = 'none';
      openApps.delete(id);
      renderTaskbarApps();
    }
    function minimizeWindow(id) { const win = document.getElementById(id); if (win) win.style.display = 'none'; }
    function renderTaskbarApps() {
      const container = document.getElementById('open-apps-container');
      container.replaceChildren();
      openApps.forEach(id => {
        const button = document.createElement('button');
        button.className = 'taskbar-app-btn';
        button.textContent = id.replace('win-', '').toUpperCase();
        button.onclick = () => openWindow(id);
        container.appendChild(button);
      });
    }
    function toggleStartMenu() {
      const menu = document.getElementById('start-menu');
      menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }
    function launchFromStart(id) { openWindow(id); document.getElementById('start-menu').style.display = 'none'; }
    function saveNote() { alert('Note saved in this session.'); }
    function handleCmd(event) {
      if (event.key !== 'Enter') return;
      const input = event.currentTarget;
      const command = input.value.trim();
      const history = document.getElementById('cmd-history');
      const output = command.toLowerCase() === 'help' ? 'Available commands: help, cls, echo <text>, date, time' :
        command.toLowerCase() === 'date' ? new Date().toLocaleDateString() :
        command.toLowerCase() === 'time' ? new Date().toLocaleTimeString() :
        command.toLowerCase() === 'cls' ? '' :
        command.toLowerCase().startsWith('echo ') ? command.slice(5) :
        command ? `'${command}' is not recognized. Type 'help' for available commands.` : '';
      history.textContent = command.toLowerCase() === 'cls' ? '' : `${history.textContent}\nC:\\Angelo_OS>${command}${output ? `\n${output}` : ''}`;
      input.value = '';
      document.querySelector('.cmd-box').scrollTop = document.querySelector('.cmd-box').scrollHeight;
    }
    document.querySelectorAll('.window').forEach(win => {
      const header = win.querySelector('.window-header');
      let drag = null;
      header.addEventListener('pointerdown', event => {
        if (event.target.closest('button')) return;
        const rect = win.getBoundingClientRect();
        drag = { x: event.clientX, y: event.clientY, left: rect.left, top: rect.top };
        header.setPointerCapture(event.pointerId);
        win.style.zIndex = ++topZ;
      });
      header.addEventListener('pointermove', event => {
        if (!drag) return;
        win.style.left = `${Math.max(0, drag.left + event.clientX - drag.x)}px`;
        win.style.top = `${Math.max(0, drag.top + event.clientY - drag.y)}px`;
      });
      const endDrag = () => { drag = null; };
      header.addEventListener('pointerup', endDrag);
      header.addEventListener('pointercancel', endDrag);
      header.addEventListener('lostpointercapture', endDrag);
    });
    function updateClock() { document.getElementById('digital-clock').textContent = new Date().toLocaleTimeString(); }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
